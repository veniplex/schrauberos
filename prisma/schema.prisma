// Datenmodell (SQLite, eine Datei). Änderungen nur über `npm run db:migrate -- <name>`.
// Bewusst portabel gehalten: keine Enums/Json-Felder – Zustände sind Strings, die als Konstanten + Zod-Schemas
// im Code definiert sind (ein späterer Wechsel der Datenbank bliebe damit möglich).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ───────────── Benutzer, Rollen, Berechtigungen ─────────────

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  name               String
  email              String?
  passwordHash       String?
  // "local" = eigene Verwaltung, "ldap" = später Active Directory
  authSource         String    @default("local")
  externalId         String?
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  // persönliche Einstellungen (null = Standard)
  locale             String?
  theme              String?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles        UserRole[]
  sessions     Session[]
  assigned     Appointment[] @relation("AppointmentAssignee")
  createdAppts Appointment[] @relation("AppointmentCreator")
  // verknüpfter Mitarbeiter (optional, 1:1)
  employee     Employee?

  @@unique([authSource, externalId])
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  // Admin-Rollen haben immer alle Berechtigungen (auch zukünftige Module)
  isAdmin     Boolean @default(false)
  // Systemrollen können nicht gelöscht werden
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]
  chapters    DocCategoryRole[]
}

model RolePermission {
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ───────────── Werkstatt-Profil (Singleton, id = "default") ─────────────

model Workshop {
  id                  String   @id @default("default")
  name                String   @default("Meine Werkstatt")
  tagline             String?
  street              String?
  zip                 String?
  city                String?
  phone               String?
  email               String?
  website             String?
  // Logo als kleines Data-URL (PNG/SVG/JPEG, max. ~200 KB) – kein Dateispeicher nötig
  logoDataUrl         String?
  accentColor         String   @default("#2459c9")
  // JSON: { "mon": ["07:30","17:00"], "sun": null }
  openingHours        String   @default("{}")
  // IANA-Zeitzone der Werkstatt (Termine werden darin ein- und ausgegeben); wird beim App-Start auf den Prozess angewendet
  timezone            String   @default("Europe/Berlin")
  updatedAt           DateTime @updatedAt
}

// Einstellungen gehören der jeweiligen Funktion (Singleton-Zeilen, bei Bedarf mit Standardwerten angelegt)

model AppointmentSettings {
  id           String   @id @default("default")
  // Kalender-Raster
  dayStartHour Int      @default(7)
  dayEndHour   Int      @default(18)
  slotMinutes  Int      @default(30)
  updatedAt    DateTime @updatedAt
}

model TireSettings {
  id                  String   @id @default("default")
  treadWarnMm         Float    @default(4.0)
  treadReplaceMm      Float    @default(3.0)
  tireAgeWarnYears    Int      @default(6)
  tireAgeReplaceYears Int      @default(10)
  updatedAt           DateTime @updatedAt
}

// ───────────── Kunden & Fahrzeuge (später aus Werbas) ─────────────

model Customer {
  id             String    @id @default(cuid())
  customerNumber String?
  firstName      String?
  lastName       String
  company        String?
  email          String?
  phone          String?
  street         String?
  zip            String?
  city           String?
  notes          String?
  // Herkunft der Daten: null = lokal angelegt, sonst z. B. "werbas"
  externalSource String?
  externalId     String?
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicles     Vehicle[]
  ownerships   VehicleOwnership[]
  appointments Appointment[]
  invoices     Invoice[]

  @@unique([externalSource, externalId])
  @@index([lastName])
}

model Vehicle {
  id             String    @id @default(cuid())
  // aktueller Halter; null = ohne Kunde (Bestand, Gebrauchtwagen, ehemaliger Kunde gelöscht)
  customerId     String?
  // normalisiert: Großbuchstaben, ohne Leerzeichen/Bindestriche (z. B. "BAB1234")
  plateNorm      String
  // wie eingegeben: "B-AB 1234"
  plate          String
  make           String?
  model          String?
  vin            String?
  year           Int?
  notes          String?
  externalSource String?
  externalId     String?
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ownerships   VehicleOwnership[]
  tireSets     TireSet[]
  appointments Appointment[]

  @@unique([externalSource, externalId])
  @@index([plateNorm])
  @@index([customerId])
}

// Halter-Historie eines Fahrzeugs (Halterwechsel). Der aktuelle Halter steht zusätzlich in Vehicle.customerId.
model VehicleOwnership {
  id         String    @id @default(cuid())
  vehicleId  String
  customerId String
  fromDate   DateTime  @default(now())
  // null = aktueller Halter
  toDate     DateTime?
  note       String?

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([customerId])
}

// ───────────── Terminplanung ─────────────

// Arbeitsplatz / Hebebühne / Stellplatz
model Bay {
  id        String  @id @default(cuid())
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  appointments Appointment[]
}

model AppointmentType {
  id             String  @id @default(cuid())
  name           String
  color          String  @default("#2459c9")
  defaultMinutes Int     @default(60)
  active         Boolean @default(true)
  sortOrder      Int     @default(0)
  // "tire_change" markiert Reifenwechsel-Termine (Verknüpfung zur Reifenliste)
  kind           String  @default("general")

  appointments Appointment[]
}

model Appointment {
  id          String   @id @default(cuid())
  title       String
  startsAt    DateTime
  endsAt      DateTime
  // scheduled | confirmed | in_progress | done | cancelled | no_show
  status      String   @default("scheduled")
  notes       String?
  typeId      String?
  bayId       String?
  customerId  String?
  vehicleId   String?
  tireSetId   String?
  assigneeId  String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  type      AppointmentType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  bay       Bay?             @relation(fields: [bayId], references: [id], onDelete: SetNull)
  customer  Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  tireSet   TireSet?         @relation(fields: [tireSetId], references: [id], onDelete: SetNull)
  assignee  User?            @relation("AppointmentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([vehicleId])
  @@index([tireSetId])
}

// ───────────── Digitale Reifenliste ─────────────

// Ein eingelagerter Reifensatz (i. d. R. 4 Reifen) eines Fahrzeugs
model TireSet {
  id              String   @id @default(cuid())
  vehicleId       String
  // summer | winter | allseason
  season          String
  brand           String?
  model           String?
  // Dimension, z. B. 205/55 R16 91H
  width           Int?
  aspect          Int?
  rim             Int?
  loadIndex       String?
  speedIndex      String?
  // none | steel | alloy
  rimType         String   @default("none")
  // stored | mounted | disposed
  status          String   @default("stored")
  // Lagerort, z. B. "Halle A / Regal 3 / Fach 2"
  storageLocation String?
  storedAt        DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tires        Tire[]
  appointments Appointment[]

  @@index([vehicleId])
  @@index([status])
}

model Tire {
  id           String    @id @default(cuid())
  tireSetId    String
  // FL | FR | RL | RR | SPARE
  position     String
  // DOT-Kürzel "WWYY" (Produktionswoche + Jahr), z. B. "2321"
  dot          String?
  producedYear Int?
  producedWeek Int?
  treadDepthMm Float?
  // new | good | fair | worn | damaged
  condition    String    @default("good")
  notes        String?
  measuredAt   DateTime?

  tireSet TireSet @relation(fields: [tireSetId], references: [id], onDelete: Cascade)

  @@unique([tireSetId, position])
}

// ───────────── IT & Netzwerk (Dokumentation) ─────────────

// Standort/Raum innerhalb des Unternehmens (z. B. Serverraum, Büro EG, Werkstatt)
model NetLocation {
  id          String  @id @default(cuid())
  name        String
  description String?
  sortOrder   Int     @default(0)

  devices NetDevice[]
}

model NetVlan {
  id          String  @id @default(cuid())
  vlanId      Int     @unique
  name        String
  description String?

  subnets NetSubnet[]
}

model NetSubnet {
  id          String  @id @default(cuid())
  name        String
  // IPv4 in CIDR-Schreibweise, z. B. 192.168.10.0/24
  cidr        String  @unique
  gateway     String?
  dnsServers  String?
  dhcpStart   String?
  dhcpEnd     String?
  description String?
  vlanId      String?

  vlan NetVlan? @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  ips  NetIp[]
}

// Gerät im Netzwerk: Server, Switch, Access Point, PC, Drucker, ...
model NetDevice {
  id             String    @id @default(cuid())
  name           String
  // server | switch | router | firewall | access_point | patch_panel | workstation | laptop | printer | nas | phone | camera | other
  type           String
  manufacturer   String?
  model          String?
  serialNumber   String?
  locationId     String?
  // z. B. "Rack 1 / HE 12"
  rackInfo       String?
  // Anzahl Ports (Switch/Patchfeld) – für die Port-Übersicht
  portCount      Int?
  // active | planned | spare | retired
  status         String    @default("active")
  assignedTo     String?
  purchaseDate   DateTime?
  warrantyUntil  DateTime?
  // Erreichbarkeits-Überwachung (aktuell nur Demo-Anzeige)
  monitorEnabled Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  location        NetLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ips             NetIp[]
  connectionsFrom NetConnection[] @relation("ConnFrom")
  connectionsTo   NetConnection[] @relation("ConnTo")

  @@index([type])
  @@index([locationId])
}

model NetIp {
  id        String   @id @default(cuid())
  address   String   @unique
  subnetId  String
  deviceId  String?
  hostname  String?
  // static | dhcp_reservation | reserved | gateway
  kind      String   @default("static")
  mac       String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subnet NetSubnet  @relation(fields: [subnetId], references: [id], onDelete: Cascade)
  device NetDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([subnetId])
  @@index([deviceId])
}

// Kabel/Verbindung zwischen zwei Geräten (Ports als freie Bezeichnung, z. B. "Gi1/0/12" oder "12")
model NetConnection {
  id           String  @id @default(cuid())
  fromDeviceId String
  fromPort     String?
  toDeviceId   String
  toPort       String?
  cableLabel   String?
  notes        String?

  from NetDevice @relation("ConnFrom", fields: [fromDeviceId], references: [id], onDelete: Cascade)
  to   NetDevice @relation("ConnTo", fields: [toDeviceId], references: [id], onDelete: Cascade)

  @@index([fromDeviceId])
  @@index([toDeviceId])
}

// ───────────── Mitarbeiter ─────────────

model Employee {
  id                  String    @id @default(cuid())
  personnelNumber     String?   @unique
  firstName           String
  lastName            String
  jobTitle            String?
  // workshop | office | it | management | other
  department          String    @default("other")
  email               String?
  phone               String?
  mobile              String?
  hireDate            DateTime?
  leaveDate           DateTime?
  active              Boolean   @default(true)
  vacationDaysPerYear Int?
  notes               String?
  // besonders schützenswerte Daten (Recht employees.sensitive)
  emergencyName       String?
  emergencyPhone      String?
  emergencyRelation   String?
  // Zuordnung zu einem Benutzerkonto (optional, 1:1)
  userId              String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  absences       Absence[]
  qualifications Qualification[]
  fleetVehicles  FleetVehicle[]
  licenseChecks  FleetLicenseCheck[]

  @@index([lastName])
}

model Absence {
  id         String   @id @default(cuid())
  employeeId String
  // vacation | sick | training | other
  type       String
  // ganze Tage, Enddatum inklusive
  startDate  DateTime
  endDate    DateTime
  note       String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startDate])
  @@index([startDate])
}

model Qualification {
  id         String    @id @default(cuid())
  employeeId String
  name       String
  issuedAt   DateTime?
  expiresAt  DateTime?
  note       String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([expiresAt])
}

// ───────────── Fuhrpark (Firmenfahrzeuge) ─────────────

model FleetVehicle {
  id               String    @id @default(cuid())
  plate            String
  make             String?
  model            String?
  vin              String?
  year             Int?
  // petrol | diesel | electric | hybrid | other
  fuelType         String?
  color            String?
  // active | in_service | reserve | sold
  status           String    @default("active")
  driverId         String?
  location         String?
  huDue            DateTime?
  serviceDue       DateTime?
  serviceDueKm     Int?
  insuranceCompany String?
  insurancePolicy  String?
  insuranceUntil   DateTime?
  leasingProvider  String?
  leasingUntil     DateTime?
  leasingRateCents Int?
  fuelCardNo       String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  driver  Employee?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  mileage FleetMileage[]
  costs   FleetCost[]

  @@index([driverId])
}

model FleetMileage {
  id             String   @id @default(cuid())
  fleetVehicleId String
  date           DateTime
  km             Int
  note           String?

  fleetVehicle FleetVehicle @relation(fields: [fleetVehicleId], references: [id], onDelete: Cascade)

  @@index([fleetVehicleId, date])
}

model FleetCost {
  id             String   @id @default(cuid())
  fleetVehicleId String
  date           DateTime
  // fuel | service | repair | tires | tax | insurance | other
  category       String
  amountCents    Int
  km             Int?
  note           String?

  fleetVehicle FleetVehicle @relation(fields: [fleetVehicleId], references: [id], onDelete: Cascade)

  @@index([fleetVehicleId, date])
}

// Führerscheinkontrolle je Fahrer (Halterpflicht)
model FleetLicenseCheck {
  id            String   @id @default(cuid())
  employeeId    String
  checkedAt     DateTime
  nextDue       DateTime
  method        String?
  note          String?
  checkedByName String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, checkedAt])
}

// ───────────── Rechnungsarchiv ─────────────

model Invoice {
  id         String    @id @default(cuid())
  // incoming = Eingangsrechnung, outgoing = Ausgangsrechnung
  direction  String
  number     String
  // Lieferant (incoming) bzw. Rechnungsempfänger (outgoing)
  partyName  String
  // optional: Kunde aus der Kundenverwaltung (nur outgoing)
  customerId String?
  issueDate  DateTime
  dueDate    DateTime?
  netCents   Int?
  vatCents   Int?
  grossCents Int
  // open | paid | cancelled  (überfällig wird aus Fälligkeit berechnet)
  status     String    @default("open")
  paidAt     DateTime?
  category   String?
  // Ablageort / Auftrags- oder Bestellnummer
  reference  String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  file     InvoiceFile?

  @@index([direction, status])
  @@index([issueDate])
  @@index([dueDate])
}

// Datei (PDF/Bild) zur Rechnung – bewusst eigenes Modell, damit Listen die Binärdaten nie mitladen
model InvoiceFile {
  id         String   @id @default(cuid())
  invoiceId  String   @unique
  name       String
  mime       String
  size       Int
  // Relativer Pfad unter <Datenverzeichnis>/files (lesbar, z. B. rechnungen/2026/eingang/2026-03-14_Lieferant_RE-1234.pdf)
  path       String   @unique
  uploadedAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ───────────── Dokumentation (Markdown) ─────────────

// Kapitel einer Dokumentation (Handbuch, IT-Dokumentation)
model DocCategory {
  id        String @id @default(cuid())
  // handbook | it
  area      String
  name      String
  sortOrder Int    @default(0)

  pages DocPage[]
  // Rollen, die dieses Kapitel lesen dürfen; leer = alle mit Leserecht auf die Dokumentation
  roles DocCategoryRole[]

  @@index([area])
}

model DocCategoryRole {
  categoryId String
  roleId     String
  category   DocCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([categoryId, roleId])
}

model DocPage {
  id            String   @id @default(cuid())
  area          String
  categoryId    String?
  title         String
  slug          String
  content       String
  pinned        Boolean  @default(false)
  createdByName String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category DocCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  versions DocVersion[]

  @@unique([area, slug])
  @@index([area])
}

model DocVersion {
  id          String   @id @default(cuid())
  pageId      String
  title       String
  content     String
  savedAt     DateTime @default(now())
  savedByName String?

  page DocPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, savedAt])
}

// Bilder in Dokumentationsseiten (Datei unter <Datenverzeichnis>/files/doku/<bereich>/)
model DocImage {
  id        String   @id @default(cuid())
  area      String
  name      String
  mime      String
  size      Int
  path      String   @unique
  createdAt DateTime @default(now())

  @@index([area])
}

// Ein-/Ausschalter für Module und Funktionen. Schlüssel: Modul-ID ("office") oder Funktions-ID ("office.fleet").
// Kein Eintrag = aktiv. Daten bleiben beim Ausschalten erhalten; es wird nur der Zugriff gesperrt.
model FeatureSetting {
  key           String   @id
  enabled       Boolean
  updatedAt     DateTime @updatedAt
  updatedByName String?
}

// Audit-Log: wer hat wann was getan. Bewusst ohne Relation zu User, damit der Verlauf auch nach dem Löschen eines Benutzers erhalten bleibt.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  // Anzeigename zum Zeitpunkt der Aktion (oder der eingegebene Benutzername bei fehlgeschlagener Anmeldung)
  actorName  String
  // Maschinenlesbare Aktion, z. B. "user.create" (Beschriftung über i18n: audit.actions.*)
  action     String
  // Betroffenes Objekt: lesbare Bezeichnung (z. B. Benutzername, Kennzeichen, Rechnungsnummer)
  target     String?
  entityId   String?

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

// Einstellungen, die zur Laufzeit in der Oberfläche geändert werden (Schlüssel/Wert). Geheimnisse liegen verschlüsselt darin
// (Schlüsseldatei im Datenverzeichnis, nicht Teil von Backups).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
