// Datenmodell (SQLite, eine Datei). Änderungen nur über `npm run db:migrate -- <name>`.
// Bewusst portabel gehalten: keine Enums/Json-Felder – Zustände sind Strings, die als Konstanten + Zod-Schemas
// im Code definiert sind (ein späterer Wechsel der Datenbank bliebe damit möglich).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ───────────── Benutzer, Rollen, Berechtigungen ─────────────

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  name               String
  email              String?
  passwordHash       String?
  // "local" = eigene Verwaltung, "ldap" = später Active Directory
  authSource         String    @default("local")
  externalId         String?
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  // persönliche Einstellungen (null = Standard)
  locale             String?
  theme              String?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles        UserRole[]
  sessions     Session[]
  assigned     Appointment[] @relation("AppointmentAssignee")
  createdAppts Appointment[] @relation("AppointmentCreator")
  // verknüpfter Mitarbeiter (optional, 1:1)
  employee     Employee?
  // Notzugang (nur Administrator-Konten)
  recoveryCode    RecoveryCode?
  recoveryNotices RecoveryNotice[]
  recoveryAcks    RecoveryNoticeAck[]
  knownDevices    KnownDevice[]
  apiTokens       ApiToken[]
  // Kalender-Abo (F10): höchstens ein Token je Benutzer
  calendarFeed    CalendarFeedToken?
  // Zweiter Faktor (TOTP) und Sicherungscodes – bewusst eigene Tabellen: Änderungen daran sollen die Version (updatedAt) des Benutzerformulars nicht berühren
  twoFactor       TwoFactor?
  backupCodes     TwoFactorBackupCode[]

  @@unique([authSource, externalId])
}

// Notzugang: Wiederherstellungs-Code eines Administrator-Kontos. Gespeichert wird nur der SHA-256-Hash, nie der Code selbst.
// Je Konto höchstens einer; beim Einlösen und beim Neuerzeugen wird die Zeile ersetzt (der alte Code ist dann ungültig).
model RecoveryCode {
  id          String    @id @default(cuid())
  userId      String    @unique
  codeHash    String    @unique
  createdAt   DateTime  @default(now())
  // Der Benutzer hat bestätigt, den Code gesichert zu haben (null = noch nicht)
  confirmedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade: gehört zum Konto (Zugangsdaten, keine Historie)
}

// Hinweis „Notzugang wurde verwendet“: sichtbar für das Konto und alle Administratoren, bis sie ihn bestätigt haben.
// Er überlebt das Löschen des Kontos (userId wird null, der Name bleibt in userName): Wer ein Konto nach einem Notzugang löscht,
// soll den Hinweis damit nicht zum Verschwinden bringen.
model RecoveryNotice {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  createdAt DateTime @default(now())

  user User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  acks RecoveryNoticeAck[]

  @@index([userId])
}

model RecoveryNoticeAck {
  noticeId String
  userId   String
  at       DateTime @default(now())

  notice RecoveryNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade) // Cascade: gehört zum Konto/Hinweis (Quittung, keine Historie)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade: gehört zum Konto/Hinweis (Quittung, keine Historie)

  @@id([noticeId, userId])
  @@index([userId])
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  // Admin-Rollen haben immer alle Berechtigungen (auch zukünftige Module)
  isAdmin     Boolean @default(false)
  // Systemrollen können nicht gelöscht werden
  isSystem    Boolean @default(false)
  // Version für das gleichzeitige Bearbeiten (siehe src/lib/concurrency.ts)
  updatedAt   DateTime @default(now()) @updatedAt

  permissions RolePermission[]
  users       UserRole[]
  chapters    DocCategoryRole[]
}

model RolePermission {
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade) // Cascade: Zuordnung der Rolle

  @@id([roleId, permission])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade: Zuordnung des Kontos
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade) // Cascade: Zuordnung des Kontos

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  // Grober Teil der Client-Adresse (IPv4 ohne letztes Byte, IPv6 nur die ersten 48 Bit) – nur hinter dem Reverse-Proxy bekannt, für die Liste „Meine Sitzungen“
  ipHint     String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade: gehört zum Konto (Betriebsdaten)

  @@index([userId])
  @@index([expiresAt])
}

// „Bekanntes Gerät“: Nach einer erfolgreichen Anmeldung bekommt der Browser ein langes, zufälliges Geräte-Cookie (gespeichert wird nur
// sein Hash). Anmeldungen mit gültigem Geräte-Cookie des Kontos unterliegen nicht der Konto-Wartezeit, die jemand ohne dieses Cookie
// durch Dauerbeschuss auslösen kann (siehe docs/platform und README, „Anmeldung“). Je Konto höchstens 10 Geräte. Ein Gerät entsteht nur, wenn die Person
// bei der Anmeldung „Dieses Gerät merken“ wählt; es ersetzt nie das Passwort und nie den zweiten Faktor.
model KnownDevice {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  ipHint     String?
  // Wie oft das Gerät angemeldet wurde (1 = nur die Anmeldung, bei der es entstand). Geräte mit 1 verdrängt ein neues Gerät zuerst; ein benutztes verdrängt nie ein anderes benutztes.
  useCount   Int      @default(1)
  // Fehlversuche vom Gerät aus (dauerhaft, überstehen einen Neustart – wie User.failedLogins) und die daraus folgende Wartezeit dieses Geräts
  failedLogins Int      @default(0)
  lockedUntil  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade: gehört zum Konto (Betriebsdaten)

  @@index([userId])
}

// Zweiter Faktor (TOTP, RFC 6238) – höchstens eine Zeile je Konto. Das Geheimnis liegt **verschlüsselt** (AES-256-GCM, Schlüssel secret.key außerhalb der Backups)
// in "secret"; nach einem Restore ohne passenden Schlüssel ist es unlesbar und die Zeile wird zurückgesetzt (secret = null, resetReason). enabledAt = null: Einrichtung
// begonnen, noch nicht bestätigt (kein zweiter Faktor bei der Anmeldung). lastStep ist der letzte akzeptierte Zeitschritt (ein Code gilt nur einmal).
model TwoFactor {
  userId         String    @id
  secret         String?
  enabledAt      DateTime?
  lastStep       Int       @default(0)
  // Fehlversuche beim zweiten Faktor (dauerhaft) und die daraus folgende Wartezeit des Kontos für diesen Schritt
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  // Grund der letzten Zurücksetzung ("key" = Backup ohne Schlüssel, "recovery" = Notzugang, "admin" = Administration), bis die Person den Hinweis bestätigt hat
  resetReason    String?
  resetAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade: gehört zum Konto (Zugangsdaten)
}

// Sicherungscodes für den Fall, dass das Telefon fehlt: je Konto 10 Einmalcodes, gespeichert nur als SHA-256-Hash (mit Konto gebunden). usedAt gesetzt = verbraucht.
model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade: gehört zum Konto (Zugangsdaten)

  @@index([userId])
}

// ───────────── Werkstatt-Profil (Singleton, id = "default") ─────────────

model Workshop {
  id                  String   @id @default("default")
  name                String   @default("Meine Werkstatt")
  tagline             String?
  street              String?
  zip                 String?
  city                String?
  phone               String?
  email               String?
  website             String?
  // Logo als kleines Data-URL (PNG/SVG/JPEG, max. ~200 KB) – kein Dateispeicher nötig
  logoDataUrl         String?
  accentColor         String   @default("#2459c9")
  // JSON: { "mon": ["07:30","17:00"], "sun": null }
  openingHours        String   @default("{}")
  // IANA-Zeitzone der Werkstatt (Termine werden darin ein- und ausgegeben); wird beim App-Start auf den Prozess angewendet
  timezone            String   @default("Europe/Berlin")
  // Werkstattprofil für Rechnungen (P4b-7): alles optional, erscheint später auf Belegen
  // Steuernummer (nur Ziffern/Trenner geprüft) und Umsatzsteuer-Identifikationsnummer (Länderpräfix + Muster geprüft)
  taxNumber           String?
  vatId               String?
  // Kleinunternehmer nach § 19 UStG: keine Umsatzsteuer, Pflichthinweis auf Belegen
  smallBusiness       Boolean  @default(false)
  bankName            String?
  // IBAN ohne Leerzeichen, Großbuchstaben (Prüfsumme mod 97 geprüft); BIC optional
  iban                String?
  bic                 String?
  // Standard-Zahlungsziel in Tagen
  paymentTermDays     Int      @default(14)
  managingDirector    String?
  registerCourt       String?
  registerNumber      String?
  // Stundenverrechnungssatz in ganzen Cent (netto bzw. bei Kleinunternehmern ohne Steuer); null = nicht festgelegt
  hourlyRateCents     Int?
  // Dauer eines Arbeitswerts (AW) in Minuten (Standard 1 AW = 5 Minuten)
  workUnitMinutes     Int      @default(5)
  // Muster der Rechnungsnummer mit Platzhaltern ({YYYY}, {YY}, {MM}, {NNNN} …), siehe src/lib/invoice-number-format.ts
  invoiceNumberFormat String   @default("{YYYY}-{NNNN}")
  updatedAt           DateTime @updatedAt
}

// ───────────── Feiertage (Plattform, P4b-0) ─────────────

// Region der Feiertage (Singleton): "" = keine Feiertage berücksichtigen; sonst "DE-NW", "AT-9", "CH-ZH" … (src/lib/holidays.ts)
model HolidaySettings {
  id        String   @id @default("default")
  region    String   @default("")
  updatedAt DateTime @updatedAt
}

// Pflege der Feiertage: Änderungen an den gesetzlichen Tagen der Region (kind "rule": gestrichen/halber Tag/eingeschaltet)
// und eigene Tage (kind "custom": Betriebsferien, Brückentage, Rosenmontag …; einmalig mit year oder jährlich ohne year)
model HolidayDay {
  id        String   @id @default(cuid())
  // rule | custom
  kind      String
  // nur kind "rule": Kennung der Regel in src/lib/holidays.ts (z. B. "corpusChristi")
  ruleKey   String?  @unique
  // nur kind "rule": off | half | on
  mode      String?
  // nur kind "custom"
  name      String?
  month     Int?
  day       Int?
  // null = jedes Jahr
  year      Int?
  half      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Einstellungen gehören der jeweiligen Funktion (Singleton-Zeilen, bei Bedarf mit Standardwerten angelegt)

model AppointmentSettings {
  id           String   @id @default("default")
  // Kalender-Raster
  dayStartHour Int      @default(7)
  dayEndHour   Int      @default(18)
  slotMinutes  Int      @default(30)
  updatedAt    DateTime @updatedAt
}

model TireSettings {
  id                  String   @id @default("default")
  treadWarnMm         Float    @default(4.0)
  treadReplaceMm      Float    @default(3.0)
  tireAgeWarnYears    Int      @default(6)
  tireAgeReplaceYears Int      @default(10)
  // Winterfenster (Monate 1–12, einschließlich; Beginn nach Ende = über den Jahreswechsel): Standard Oktober bis März
  winterStartMonth    Int      @default(10)
  winterEndMonth      Int      @default(3)
  updatedAt           DateTime @updatedAt
}

// ───────────── Kunden & Fahrzeuge ─────────────

model Customer {
  id             String    @id @default(cuid())
  customerNumber String?
  firstName      String?
  lastName       String
  company        String?
  email          String?
  phone          String?
  street         String?
  zip            String?
  city           String?
  notes          String?
  // Normalisierte Suchspalten (src/lib/search-key.ts, von den Operationen gepflegt): Name/Firma, Ort (klein, ohne Akzente, ä/ae/a), Telefon nur Ziffern
  nameKey        String    @default("")
  cityKey        String    @default("")
  phoneKey       String    @default("")
  // Archiviert (P4b-2): aus Auswahlfeldern, Suche und Neu-Formularen ausgeblendet, per Filter auffindbar, wieder aktivierbar; Verknüpfungen bleiben
  archivedAt     DateTime?
  // Datenschutz (P4b-5): Verarbeitung eingeschränkt (Art. 18 DSGVO) – aus Suche, Auswahl, Schnellsuche, API/Webhooks und iCal ausgeblendet, im Detail sichtbar mit Hinweis; mit kurzer Notiz zum Anlass
  processingRestrictedAt DateTime?
  restrictionNote        String?
  // Stammsatz anonymisiert (nach Ablauf der Aufbewahrungsfrist): alle personenbezogenen Felder sind geleert, die Verknüpfungen zu Rechnungen bleiben
  anonymizedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicles     Vehicle[]
  ownerships   VehicleOwnership[]
  appointments Appointment[]
  invoices     Invoice[]
  orders       Order[]

  @@index([lastName])
  @@index([archivedAt])
  @@index([processingRestrictedAt])
}

// Datenschutz-Einstellungen (Singleton): Aufbewahrungsfristen in Jahren je Belegart und die Bestätigung durch einen Administrator. Die Standardwerte sind Platzhalter – erst nach der
// Bestätigung (`retentionConfirmedAt`, am besten nach Rückfrage beim Steuerberater) darf ein Kunde anonymisiert werden. Eine Änderung der Fristen nimmt die Bestätigung zurück.
model PrivacySettings {
  id                       String    @id @default("default")
  // Rechnungen und Stornorechnungen (Buchungsbelege)
  retentionInvoiceYears    Int       @default(8)
  // festgeschriebene Rechnungen (als Teil der Bücher geführt)
  retentionBooksYears      Int       @default(10)
  retentionConfirmedAt     DateTime?
  retentionConfirmedByName String?
  updatedAt                DateTime  @updatedAt
}

model Vehicle {
  id             String    @id @default(cuid())
  // aktueller Halter; null = ohne Kunde (Bestand, Gebrauchtwagen). Ein Kunde mit Fahrzeugen ist nicht löschbar (Restrict), das Fahrzeug verliert den Halter also nie durch Löschen.
  customerId     String?
  // normalisiert: Großbuchstaben, ohne Leerzeichen/Bindestriche (z. B. "BAB1234")
  plateNorm      String
  // wie eingegeben: "B-AB 1234"
  plate          String
  make           String?
  model          String?
  vin            String?
  year           Int?
  // Kilometerstand (zuletzt bekannt)
  mileageKm      Int?
  // Kraftstoff: petrol | diesel | hybrid | electric | lpg | cng | hydrogen | other (Konstanten im Code, keine Enum)
  fuel           String?
  // Schlüsselnummern der Zulassungsbescheinigung: Herstellerschlüssel (4 Zeichen) und Typschlüssel (3 Zeichen), Großbuchstaben/Ziffern
  hsn            String?
  tsn            String?
  firstRegistration DateTime?
  // Hauptuntersuchung bzw. nächste wiederkehrende Prüfung als "JJJJ-MM" (der Monat genügt; neutral benannt, damit auch andere Prüfungen und Länder passen)
  inspectionDue  String?
  // weitere Prüfung (sp | gas | other) mit Fälligkeitsdatum – beides oder keines
  extraInspectionKind String?
  extraInspectionDue  DateTime?
  notes          String?
  // Normalisierte Suchspalte (src/lib/search-key.ts, von den Operationen gepflegt): Marke, Modell, FIN
  searchKey      String    @default("")
  // Archiviert (P4b-2): wie beim Kunden; ein archiviertes Fahrzeug zählt nicht für die Kennzeichen-Dublettenwarnung
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  ownerships   VehicleOwnership[]
  tireSets     TireSet[]
  appointments Appointment[]
  orders       Order[]
  invoices     Invoice[]
  // Dokumente & Fotos (F6): Fahrzeuge mit Dateien sind nicht löschbar (archivieren)
  files        FileAttachment[]
  // Checklisten (F7): Fahrzeuge mit Checklisten sind nicht löschbar (archivieren)
  checklists   Checklist[]

  // Kein Unique auf dem Kennzeichen: Dubletten sind erlaubt (Warnung mit Bestätigung in der Anwendung), etwa bei Halterwechsel oder wiederverwendeten Kennzeichen
  @@index([plateNorm])
  @@index([customerId])
  @@index([inspectionDue])
  @@index([archivedAt])
}

// Halter-Historie eines Fahrzeugs (Halterwechsel). Der aktuelle Halter steht zusätzlich in Vehicle.customerId.
model VehicleOwnership {
  id         String    @id @default(cuid())
  vehicleId  String
  customerId String
  fromDate   DateTime  @default(now())
  // null = aktueller Halter
  toDate     DateTime?
  note       String?

  // Restrict statt Cascade (P4b-2): die Halter-Historie verschwindet nie stillschweigend mit dem Fahrzeug; ein Fahrzeug mit Historie wird archiviert
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([vehicleId])
  @@index([customerId])
}

// ───────────── Terminplanung ─────────────

// Arbeitsplatz / Hebebühne / Stellplatz
model Bay {
  id        String  @id @default(cuid())
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  updatedAt DateTime @updatedAt

  appointments Appointment[]
}

model AppointmentType {
  id             String  @id @default(cuid())
  name           String
  color          String  @default("#2459c9")
  defaultMinutes Int     @default(60)
  active         Boolean @default(true)
  sortOrder      Int     @default(0)
  // "tire_change" markiert Reifenwechsel-Termine (Verknüpfung zur Reifenliste)
  kind           String  @default("general")
  updatedAt DateTime @updatedAt

  appointments Appointment[]
}

model Appointment {
  id          String   @id @default(cuid())
  title       String
  startsAt    DateTime
  endsAt      DateTime
  // scheduled | confirmed | in_progress | done | cancelled | no_show
  status      String   @default("scheduled")
  notes       String?
  typeId      String?
  bayId       String?
  customerId  String?
  vehicleId   String?
  tireSetId   String?
  assigneeId  String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  type      AppointmentType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  bay       Bay?             @relation(fields: [bayId], references: [id], onDelete: SetNull)
  customer  Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  tireSet   TireSet?         @relation(fields: [tireSetId], references: [id], onDelete: SetNull)
  assignee  User?            @relation("AppointmentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orders    Order[]

  @@index([startsAt])
  @@index([vehicleId])
  @@index([tireSetId])
  @@index([customerId])
  @@index([bayId])
  @@index([typeId])
  @@index([assigneeId])
  @@index([createdById])
}

// ───────────── Kalender-Abo (F10, workshop.appointments) ─────────────

// Abonnierbarer Kalender (.ics) je Benutzer: Die Adresse enthält ein langes Zufalls-Token, gespeichert wird nur sein SHA-256-Hash (der Klartext steht einmal in der Antwort der Erzeugung). Höchstens ein Token je Benutzer
// (`userId` ist eindeutig): Erneuern ersetzt die Zeile, Widerrufen löscht sie. Ablauf optional. `lastUsedAt` wird auf die Stunde gerundet und höchstens einmal je Stunde geschrieben (keine Schreibflut).
// Passwortwechsel, Deaktivierung und Notzugang löschen das Token (`revokeAccess`); wirksam sind bei jedem Abruf die aktuellen Rechte des Besitzers.
model CalendarFeedToken {
  id         String    @id @default(cuid())
  userId     String    @unique
  tokenHash  String    @unique
  // erste Zeichen des Tokens (nicht geheim, nur zum Wiedererkennen)
  hint       String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade: gehört zum Konto (Zugangsdaten)
}

// ───────────── Digitale Reifenliste ─────────────

// Ein eingelagerter Reifensatz (i. d. R. 4 Reifen) eines Fahrzeugs
model TireSet {
  id              String   @id @default(cuid())
  vehicleId       String
  // summer | winter | allseason
  season          String
  brand           String?
  model           String?
  // Dimension, z. B. 205/55 R16 91H
  width           Int?
  aspect          Int?
  rim             Int?
  loadIndex       String?
  speedIndex      String?
  // none | steel | alloy
  rimType         String   @default("none")
  // stored (im Lager) | mounted (ausgelagert, beim Kunden montiert) | disposed
  status          String   @default("stored")
  // Lagerort, z. B. "Halle A / Regal 3 / Fach 2"
  storageLocation String?
  storedAt        DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict) // Restrict: Reifensätze sind Historie des Fahrzeugs: ein Fahrzeug mit Reifensätzen wird archiviert
  tires        Tire[]
  appointments Appointment[]

  @@index([vehicleId])
  @@index([status])
}

model Tire {
  id           String    @id @default(cuid())
  tireSetId    String
  // FL | FR | RL | RR | SPARE
  position     String
  // DOT-Kürzel "WWYY" (Produktionswoche + Jahr), z. B. "2321"
  dot          String?
  producedYear Int?
  producedWeek Int?
  treadDepthMm Float?
  // new | good | fair | worn | damaged
  condition    String    @default("good")
  notes        String?
  measuredAt   DateTime?

  tireSet TireSet @relation(fields: [tireSetId], references: [id], onDelete: Cascade) // Cascade: Bestandteil des Reifensatzes (nur mit ihm zusammen löschbar)

  @@unique([tireSetId, position])
}

// ───────────── IT & Netzwerk (Dokumentation) ─────────────

// Standort/Raum innerhalb des Unternehmens (z. B. Serverraum, Büro EG, Werkstatt)
model NetLocation {
  id          String  @id @default(cuid())
  name        String
  description String?
  sortOrder   Int     @default(0)
  updatedAt DateTime @updatedAt

  devices NetDevice[]
}

model NetVlan {
  id          String  @id @default(cuid())
  vlanId      Int     @unique
  name        String
  description String?
  updatedAt DateTime @updatedAt

  subnets NetSubnet[]
}

model NetSubnet {
  id          String  @id @default(cuid())
  name        String
  // IPv4 in CIDR-Schreibweise, z. B. 192.168.10.0/24 (/16 bis /32). Nicht global eindeutig: Dasselbe Netz darf in getrennten VLANs vorkommen; im selben VLAN verhindert die Operation Überschneidungen (P4b-6)
  cidr        String
  gateway     String?
  dnsServers  String?
  dhcpStart   String?
  dhcpEnd     String?
  description String?
  vlanId      String?
  updatedAt DateTime @updatedAt

  vlan NetVlan? @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  ips  NetIp[]

  @@index([cidr])
  @@index([vlanId])
}

// Gerät im Netzwerk: Server, Switch, Access Point, PC, Drucker, ...
model NetDevice {
  id             String    @id @default(cuid())
  name           String
  // server | switch | router | firewall | access_point | patch_panel | workstation | laptop | printer | nas | phone | camera | other
  type           String
  manufacturer   String?
  model          String?
  serialNumber   String?
  locationId     String?
  // z. B. "Rack 1 / HE 12"
  rackInfo       String?
  // Anzahl Ports (Switch/Patchfeld) – für die Port-Übersicht
  portCount      Int?
  // active | planned | spare | retired
  status         String    @default("active")
  assignedTo     String?
  purchaseDate   DateTime?
  warrantyUntil  DateTime?
  // Vormerken für die Erreichbarkeits-Überwachung; gemessen wird, sobald ein Überwachungsziel (NetMonitorTarget) auf das Gerät verweist
  monitorEnabled Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  location        NetLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ips             NetIp[]
  connectionsFrom NetConnection[] @relation("ConnFrom")
  connectionsTo   NetConnection[] @relation("ConnTo")
  monitorTargets  NetMonitorTarget[]

  @@index([type])
  @@index([locationId])
}

model NetIp {
  id        String   @id @default(cuid())
  // eindeutig je Netz (Subnetz), nicht global: dieselbe Adresse darf in getrennten Netzen vorkommen (P4b-6)
  address   String
  subnetId  String
  deviceId  String?
  hostname  String?
  // static | dhcp_reservation | reserved | gateway
  kind      String   @default("static")
  mac       String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subnet NetSubnet  @relation(fields: [subnetId], references: [id], onDelete: Cascade) // Cascade: Dokumentation des Subnetzes (Konfiguration, keine Historie)
  device NetDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([subnetId, address])
  @@index([deviceId])
  @@index([address])
}

// Kabel/Verbindung zwischen zwei Geräten (Ports als freie Bezeichnung, z. B. "Gi1/0/12" oder "12")
model NetConnection {
  id           String  @id @default(cuid())
  fromDeviceId String
  fromPort     String?
  toDeviceId   String
  toPort       String?
  cableLabel   String?
  notes        String?

  from NetDevice @relation("ConnFrom", fields: [fromDeviceId], references: [id], onDelete: Cascade) // Cascade: Dokumentation des Geräts (Konfiguration, keine Historie)
  to   NetDevice @relation("ConnTo", fields: [toDeviceId], references: [id], onDelete: Cascade) // Cascade: Dokumentation des Geräts (Konfiguration, keine Historie)

  @@index([fromDeviceId])
  @@index([toDeviceId])
}

// ───────────── IT-Tresor (F13) ─────────────

// Zugangsdaten zu IT-Systemen. Titel, Art und Systembezeichnung stehen im Klartext (Liste, Suche in der Liste); URL, Benutzername, Geheimnis und Notiz nur verschlüsselt (Envelope-Verschlüsselung, README „IT-Tresor“):
// ein zufälliger 256-Bit-Eintragsschlüssel (DEK) verschlüsselt den Nutzdatenblock mit AES-256-GCM (AAD = Eintrags-ID, Format und Revision), der DEK ist mit dem Schlüssel aus secret.key umhüllt (AAD = Eintrags-ID).
// Ohne secret.key (Backup ohne Schlüssel) sind beide nicht lesbar – die Zeile bleibt, bis die Administration sie zurücksetzt (Sicherung der Zeilen nach secret-reset/), dann steht dort „Neu eingeben nötig“.
model VaultEntry {
  id            String    @id @default(cuid())
  title         String
  // server | network | account | other
  kind          String    @default("other")
  // Bezeichnung des Systems (Freitext, z. B. "fw-01"), kein Geheimnis
  system        String?
  // Format der verschlüsselten Teile (Version der Konstruktion, Teil der AAD)
  format        Int       @default(1)
  // Zähler: steigt mit jeder neuen Verschlüsselung (Teil der AAD des Blocks)
  revision      Int       @default(1)
  // umhüllter Eintragsschlüssel; null = keine Zugangsdaten hinterlegt oder nicht lesbar (dann ist unreadableAt gesetzt)
  wrappedKey    String?
  // verschlüsselter Block aus URL, Benutzername, Geheimnis und Notiz
  payload       String?
  // gesetzt, wenn die Geheimnisse nach einer Wiederherstellung ohne passenden Schlüssel zurückgesetzt wurden („Neu eingeben nötig“)
  unreadableAt  DateTime?
  createdByName String?
  updatedByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([kind])
}

// ───────────── Netzwerk-Überwachung (F12) ─────────────

// Ein Ziel der Erreichbarkeitsprüfung: TCP-Verbindung oder HTTP(S)-Anfrage, nie ICMP. Gespeichert wird nur, was die Anwendung gemessen hat (Zustand, Latenz, Statusklasse) – nie ein Antworttext.
model NetMonitorTarget {
  id              String             @id @default(cuid())
  name            String
  // tcp | http | https
  kind            String
  // Name oder IP-Adresse in kanonischer Schreibweise (ohne Klammern); beim Prüfen wird sie erneut gegen die Zielsperre geprüft
  host            String
  port            Int
  // nur http/https: Pfad samt Query (beginnt mit "/"), nie Zugangsdaten
  path            String?
  // HEAD | GET (nur http/https)
  method          String             @default("HEAD")
  // Zertifikatsfehler (abgelaufen, fremder Aussteller, falscher Name) nicht als Warnung melden
  ignoreTlsErrors Boolean            @default(false)
  intervalSec     Int                @default(300)
  enabled         Boolean            @default(true)
  deviceId        String?
  device          NetDevice?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  // aktueller Zustand: unknown | up | warn | down (erst nach zwei aufeinanderfolgenden Fehlschlägen "down")
  state           String             @default("unknown")
  stateSince      DateTime?
  failStreak      Int                @default(0)
  lastCheckAt     DateTime?
  lastLatencyMs   Int?
  lastClass       String?
  // Beginn der nächsten Prüfung; der Job belegt ein Ziel, indem er dieses Datum bedingt weiterschiebt (kein Doppellauf)
  nextCheckAt     DateTime           @default(now())
  createdByName   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  // Cascade mit Absicht: Messwerte sind ein Betriebsprotokoll (7 Tage roh, 30 Tage als Stundenwerte), keine Nachweise über Fachdaten – das Audit-Log hält das Löschen des Ziels fest; die Oberfläche kündigt an, dass der Verlauf mitgelöscht wird
  samples         NetMonitorSample[]
  hours           NetMonitorHour[]
  events          NetMonitorEvent[]

  @@index([deviceId])
  @@index([nextCheckAt])
}

// Einzelmessung (Rohwert, 7 Tage): ohne Antworttext, ohne Kopfzeilen
model NetMonitorSample {
  id          String           @id @default(cuid())
  targetId    String
  target      NetMonitorTarget @relation(fields: [targetId], references: [id], onDelete: Cascade) // Cascade: Betriebsprotokoll der Überwachung (Messwerte, nach Frist ohnehin gelöscht)
  at          DateTime
  // erreichbar (inkl. Zertifikatswarnung)
  ok          Boolean
  latencyMs   Int?
  // 2xx | 3xx | 4xx | 5xx | open | tlsWarning | timeout | refused | unreachable | dns | tls | blocked | protocol | error
  statusClass String

  @@index([targetId, at])
  @@index([at])
}

// Verdichtete Stundenwerte (30 Tage): aus den Rohwerten, die älter als 7 Tage sind
model NetMonitorHour {
  id           String           @id @default(cuid())
  targetId     String
  target       NetMonitorTarget @relation(fields: [targetId], references: [id], onDelete: Cascade) // Cascade: Betriebsprotokoll der Überwachung (Messwerte, nach Frist ohnehin gelöscht)
  // Beginn der Stunde (UTC)
  hour         DateTime
  checks       Int
  failures     Int
  latencySumMs Int
  latencyCount Int
  latencyMaxMs Int?

  @@unique([targetId, hour])
  @@index([hour])
}

// Zustandswechsel: down = Ausfall (nach Entprellung), up = Wiederkehr (mit Dauer des Ausfalls)
model NetMonitorEvent {
  id          String           @id @default(cuid())
  targetId    String
  target      NetMonitorTarget @relation(fields: [targetId], references: [id], onDelete: Cascade) // Cascade: Betriebsprotokoll der Überwachung (Messwerte, nach Frist ohnehin gelöscht)
  at          DateTime
  // down | up
  kind        String
  downSeconds Int?

  @@index([targetId, at])
  @@index([at])
}

// ───────────── Mitarbeiter ─────────────

model Employee {
  id                  String    @id @default(cuid())
  personnelNumber     String?   @unique
  firstName           String
  lastName            String
  jobTitle            String?
  // workshop | office | it | management | other
  department          String    @default("other")
  email               String?
  phone               String?
  mobile              String?
  hireDate            DateTime?
  leaveDate           DateTime?
  active              Boolean   @default(true)
  vacationDaysPerYear Int?
  // Arbeitstage der Woche (Teilzeit, P4b-4): Wochentage 0 = Sonntag … 6 = Samstag, kommagetrennt, aufsteigend; Standard Montag bis Freitag. Abwesenheits-Arbeitstage zählen nur diese Tage (ohne Feiertage).
  workWeekdays        String    @default("1,2,3,4,5")
  // Manuell erfasster Resturlaub aus dem Vorjahr zu Beginn des Jahres vacationCarryYear (z. B. beim Start mit der Anwendung); ab da rechnet die Anwendung den Übertrag selbst
  vacationCarryYear   Int?
  vacationCarryDays   Float?
  notes               String?
  // besonders schützenswerte Daten (Recht employees.sensitive)
  emergencyName       String?
  emergencyPhone      String?
  emergencyRelation   String?
  // Zuordnung zu einem Benutzerkonto (optional, 1:1)
  userId              String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  absences       Absence[]
  qualifications Qualification[]
  fleetVehicles  FleetVehicle[]
  licenseChecks  FleetLicenseCheck[]
  // Zeiterfassung (F5): Mitarbeiter mit Zeiteinträgen sind nicht löschbar (Aufzeichnungspflicht), nur inaktiv zu setzen
  timeEntries    TimeEntry[]

  @@index([lastName])
}

model Absence {
  id         String   @id @default(cuid())
  employeeId String
  // vacation | sick | training | other
  type       String
  // ganze Tage, Enddatum inklusive
  startDate  DateTime
  endDate    DateTime
  note       String?
  createdAt  DateTime @default(now())
  // Version für gleichzeitiges Bearbeiten (P4b-4)
  updatedAt  DateTime @default(now()) @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict) // Restrict: Abwesenheiten sind Historie: ein Mitarbeiter mit Abwesenheiten wird deaktiviert, nicht gelöscht

  @@index([employeeId, startDate])
  @@index([startDate])
}

model Qualification {
  id         String    @id @default(cuid())
  employeeId String
  name       String
  issuedAt   DateTime?
  expiresAt  DateTime?
  note       String?
  // Version für gleichzeitiges Bearbeiten (P4b-4)
  updatedAt  DateTime  @default(now()) @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade) // Cascade: Stammdaten des Mitarbeiters (Nachweise gehören zur Person), kein Verlauf

  @@index([employeeId])
  @@index([expiresAt])
}

// Einstellungen der Mitarbeiterverwaltung (Singleton): Stichtag, an dem der Resturlaub des Vorjahres verfällt (Standard 31.03.)
model EmployeeSettings {
  id                 String   @id @default("default")
  vacationCarryMonth Int      @default(3)
  vacationCarryDay   Int      @default(31)
  updatedAt          DateTime @updatedAt
}

// ───────────── Fuhrpark (Firmenfahrzeuge) ─────────────

model FleetVehicle {
  id               String    @id @default(cuid())
  plate            String
  make             String?
  model            String?
  vin              String?
  year             Int?
  // petrol | diesel | electric | hybrid | other
  fuelType         String?
  color            String?
  // active | in_service | reserve | sold
  status           String    @default("active")
  driverId         String?
  location         String?
  huDue            DateTime?
  serviceDue       DateTime?
  serviceDueKm     Int?
  insuranceCompany String?
  insurancePolicy  String?
  insuranceUntil   DateTime?
  leasingProvider  String?
  leasingUntil     DateTime?
  leasingRateCents Int?
  fuelCardNo       String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  driver  Employee?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  mileage FleetMileage[]
  costs   FleetCost[]

  @@index([driverId])
}

model FleetMileage {
  id             String   @id @default(cuid())
  fleetVehicleId String
  date           DateTime
  km             Int
  note           String?

  fleetVehicle FleetVehicle @relation(fields: [fleetVehicleId], references: [id], onDelete: Restrict) // Restrict: Kilometerstände sind Historie: ein Fahrzeug mit Verlauf wird auf „verkauft“ gesetzt, nicht gelöscht

  @@index([fleetVehicleId, date])
}

model FleetCost {
  id             String   @id @default(cuid())
  fleetVehicleId String
  date           DateTime
  // fuel | service | repair | tires | tax | insurance | other
  category       String
  amountCents    Int
  km             Int?
  note           String?

  fleetVehicle FleetVehicle @relation(fields: [fleetVehicleId], references: [id], onDelete: Restrict) // Restrict: Kosten sind Historie: ein Fahrzeug mit Verlauf wird auf „verkauft“ gesetzt, nicht gelöscht

  @@index([fleetVehicleId, date])
}

// Führerscheinkontrolle je Fahrer (Halterpflicht)
model FleetLicenseCheck {
  id            String   @id @default(cuid())
  employeeId    String
  checkedAt     DateTime
  nextDue       DateTime
  method        String?
  note          String?
  checkedByName String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict) // Restrict: Führerscheinkontrollen sind ein Halter-Nachweis und verschwinden nie mit dem Mitarbeiter

  @@index([employeeId, checkedAt])
}

// ───────────── Rechnungsarchiv ─────────────

model Invoice {
  id         String    @id @default(cuid())
  // incoming = Eingangsrechnung, outgoing = Ausgangsrechnung
  direction  String
  number     String
  // Eindeutigkeit der Ausgangsrechnungsnummer: normalisierte Nummer (siehe normalizeInvoiceNumber), nur bei direction = outgoing, bei Eingang NULL
  outgoingKey String?   @unique
  // Lieferant (incoming) bzw. Rechnungsempfänger (outgoing)
  partyName  String
  // normalisierte Suchspalte zu partyName (src/lib/search-key.ts, von den Operationen gepflegt)
  partyKey   String    @default("")
  // optional: Kunde aus der Kundenverwaltung (nur outgoing)
  customerId String?
  issueDate  DateTime
  dueDate    DateTime?
  netCents   Int?
  vatCents   Int?
  grossCents Int
  // open | paid | cancelled  (überfällig wird aus Fälligkeit berechnet)
  status     String    @default("open")
  paidAt     DateTime?
  category   String?
  // Ablageort / Auftrags- oder Bestellnummer
  reference  String?
  notes      String?
  // Festgeschrieben (P4b-3, nur Ausgangsrechnungen): Inhalt, Beträge und Beleg sind danach unveränderlich, die Rechnung ist nicht löschbar; nur der Zahlstatus bleibt änderbar.
  // Korrigiert wird dann per Gegenbeleg (Stornorechnung/Gutschrift). Der Name der festschreibenden Person steht als Text (bleibt, auch wenn das Konto gelöscht wird).
  finalizedAt      DateTime?
  finalizedByName  String?
  // Gegenbeleg: Verweis auf die stornierte Rechnung (je Rechnung höchstens ein Gegenbeleg); null = gewöhnliche Rechnung
  cancelsInvoiceId String?   @unique

  // ── Rechnungserstellung (F3, office.billing) ──
  // Herkunft: manual = von Hand erfasst (Archiv); billing = in der Rechnungserstellung angelegt (Entwurf ohne Nummer bis zum Festschreiben/Ausstellen)
  source         String    @default("manual")
  // Belegart: invoice | partial (Abschlag) | final (Schlussrechnung) | credit (Stornorechnung/Gutschrift) | offer (Angebot) | confirmation (Auftragsbestätigung). Angebote und Auftragsbestätigungen sind keine Buchungsbelege:
  // sie stehen nie in der Ausgangsliste und zählen in keiner Summe
  docType        String    @default("invoice")
  // nur Angebote: open | accepted | rejected (abgelaufen wird aus validUntil berechnet)
  offerStatus    String?
  validUntil     DateTime?
  acceptedAt     DateTime?
  acceptedByName String?
  // Leistungsdatum bzw. Leistungszeitraum (§ 14 UStG)
  serviceFrom    DateTime?
  serviceTo      DateTime?
  introText      String?
  footerText     String?
  // Zahlungsziel in Tagen ab Rechnungsdatum (die Fälligkeit entsteht beim Festschreiben); Zahlungsart: transfer | cash | card | other
  paymentDays    Int?
  paymentMethod  String?
  // Anschrift des Empfängers (Name steht in partyName); bei Belegen der Rechnungserstellung vom Kunden vorbelegt und bis zum Festschreiben änderbar
  partyStreet    String?
  partyZip       String?
  partyCity      String?
  // Käuferreferenz/Leitweg-ID (nur für die XRechnung nötig) und E-Mail des Empfängers (XRechnung, Versand)
  buyerReference String?
  buyerEmail     String?
  // Hinweis zur Steuerbefreiung (nur bei Positionen mit 0 %)
  taxNote        String?
  // Kleinunternehmer (§ 19 UStG) zum Zeitpunkt der Erstellung; maßgeblich ist nach dem Festschreiben der Schnappschuss
  exempt         Boolean   @default(false)
  // Fahrzeug (Anzeige auf dem Beleg, Voraussetzung für „Angebot → Auftrag“), Auftrag und Ursprungsbeleg (Angebot → Auftragsbestätigung/Auftrag)
  vehicleId      String?
  vehicleLabel   String?
  mileageKm      Int?
  orderId        String?
  sourceDocId    String?
  // Summe der angerechneten Abschläge (brutto, Schlussrechnung) und der bisherigen Zahlungen; zu zahlen = Brutto − angerechnet − gezahlt
  deductedCents  Int       @default(0)
  // Netto- und Steueranteil der angerechneten Abschläge (Schlussrechnung): beim Festschreiben festgeschrieben, beim Gegenbeleg negiert – der Umsatzbericht rechnet nur aus den Spalten des Belegs,
  // damit sich ein abgeschlossener Monat nie rückwirkend ändert (auch nicht, wenn die Anrechnung nach einem Storno wieder frei wird)
  deductedNetCents Int     @default(0)
  deductedVatCents Int     @default(0)
  paidCents      Int       @default(0)
  // Versand per E-Mail: wann zuletzt und wie oft (die Adresse steht nur im Sendeprotokoll)
  sentAt         DateTime?
  sentCount      Int       @default(0)
  createdByName  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  file        InvoiceFile?
  cancels     Invoice?     @relation("InvoiceStorno", fields: [cancelsInvoiceId], references: [id], onDelete: Restrict)
  cancelledBy Invoice?     @relation("InvoiceStorno")
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sourceDoc   Invoice?     @relation("InvoiceSource", fields: [sourceDocId], references: [id], onDelete: Restrict)
  derivedDocs Invoice[]    @relation("InvoiceSource")
  items       InvoiceItem[]
  payments    InvoicePayment[]
  sentFiles   InvoiceSentFile[]
  snapshot    InvoiceSnapshot?
  // Schlussrechnung: die angerechneten Abschlagsrechnungen; Abschlag: in welchen Schlussrechnungen vorgesehen
  deductions  InvoiceDeduction[] @relation("FinalDeductions")
  deductedIn  InvoiceDeduction[] @relation("DeductedPartial")

  @@index([direction, status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([customerId])
  @@index([source, docType, finalizedAt])
  @@index([orderId])
  @@index([sourceDocId])
  @@index([vehicleId])
}

// Position eines Beleges der Rechnungserstellung (wie OrderItem: Netto-Einzelpreis in Cent, Menge in Tausendsteln, Sätze in Basispunkten, src/lib/line-items.ts). Löschen nur mit dem Entwurf.
model InvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String
  position      Int
  // labor | part | other
  kind          String  @default("labor")
  description   String
  unit          String  @default("")
  quantityMilli Int
  unitCents     Int
  taxBp         Int
  discountBp    Int     @default(0)
  refType       String?
  refId         String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Cascade: Bestandteil der Rechnung (festgeschriebene Rechnungen werden nie gelöscht)

  @@index([invoiceId, position])
}

// Zahlungseingang zu einer festgeschriebenen Rechnung (Teilzahlungen); Korrekturen als Entfernen mit Audit
model InvoicePayment {
  id             String   @id @default(cuid())
  invoiceId      String
  paidAt         DateTime
  amountCents    Int
  // transfer | cash | card | other
  method         String
  note           String?
  recordedByName String
  createdAt      DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, paidAt])
}

// Anhänge (PDF, XRechnung), die der Versand eines Belegs per E-Mail im Dateispeicher abgelegt hat (`rechnungen/versand/…`). `purgeAfter`: ab diesem Zeitpunkt löst der Aufräumlauf die Datei vom Datenträger
// (Angebote und Auftragsbestätigungen nach 30 Tagen; bei Rechnungen null: sie bleiben als Kopie „wie versendet“ bis zur Anonymisierung des Kunden, die `purgeAfter` auf „jetzt“ setzt).
model InvoiceSentFile {
  id         String    @id @default(cuid())
  invoiceId  String
  path       String
  createdAt  DateTime  @default(now())
  purgeAfter DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([purgeAfter])
}

// Unveränderlicher Schnappschuss von Absender (Werkstattprofil) und Empfänger (Kunde) zum Zeitpunkt des Festschreibens bzw. Ausstellens: ändert sich später das Profil oder der Kunde, ändert sich der Beleg nicht.
// Wird nur angelegt, nie geändert (keine Operation schreibt hier außer dem Festschreiben).
model InvoiceSnapshot {
  invoiceId       String   @id
  createdAt       DateTime @default(now())
  sName           String
  sStreet         String?
  sZip            String?
  sCity           String?
  sPhone          String?
  sEmail          String?
  sWebsite        String?
  sTaxNumber      String?
  sVatId          String?
  sBankName       String?
  sIban           String?
  sBic            String?
  sDirector       String?
  sRegisterCourt  String?
  sRegisterNumber String?
  sSmallBusiness  Boolean  @default(false)
  rName           String
  rStreet         String?
  rZip            String?
  rCity           String?
  rEmail          String?
  rCustomerNumber String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Cascade: Bestandteil der Rechnung (festgeschriebene Rechnungen werden nie gelöscht)
}

// Anrechnung einer Abschlagsrechnung in einer Schlussrechnung. `finalKey` (= Kennung des Abschlags) ist erst nach dem Festschreiben der Schlussrechnung gesetzt und eindeutig: ein Abschlag wird nie zweimal angerechnet.
model InvoiceDeduction {
  id         String  @id @default(cuid())
  finalId    String
  partialId  String
  finalKey   String? @unique

  final   Invoice @relation("FinalDeductions", fields: [finalId], references: [id], onDelete: Cascade) // Cascade: Bestandteil der Schlussrechnung (festgeschriebene Rechnungen werden nie gelöscht)
  partial Invoice @relation("DeductedPartial", fields: [partialId], references: [id], onDelete: Restrict)

  @@unique([finalId, partialId])
  @@index([partialId])
}

// Datei (PDF/Bild) zur Rechnung – bewusst eigenes Modell, damit Listen die Binärdaten nie mitladen
model InvoiceFile {
  id         String   @id @default(cuid())
  invoiceId  String   @unique
  name       String
  mime       String
  size       Int
  // Relativer Pfad unter <Datenverzeichnis>/files (lesbar, z. B. rechnungen/2026/eingang/2026-03-14_Lieferant_RE-1234.pdf)
  path       String   @unique
  uploadedAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // Cascade: Bestandteil der Rechnung (festgeschriebene Rechnungen werden nie gelöscht)
}

// ───────────── Dokumentation (Markdown) ─────────────

// Kapitel einer Dokumentation (Handbuch, IT-Dokumentation)
model DocCategory {
  id        String @id @default(cuid())
  // handbook | it
  area      String
  name      String
  sortOrder Int    @default(0)
  updatedAt DateTime @updatedAt

  pages DocPage[]
  // Rollen, die dieses Kapitel lesen dürfen; leer = alle mit Leserecht auf die Dokumentation
  roles DocCategoryRole[]

  @@index([area])
}

model DocCategoryRole {
  categoryId String
  roleId     String
  category   DocCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade) // Cascade: Zuordnung des Kapitels
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade) // Cascade: Zuordnung des Kapitels

  @@id([categoryId, roleId])
  @@index([roleId])
}

model DocPage {
  id            String   @id @default(cuid())
  area          String
  categoryId    String?
  title         String
  slug          String
  content       String
  pinned        Boolean  @default(false)
  createdByName String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category DocCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  versions DocVersion[]

  @@unique([area, slug])
  @@index([area])
  @@index([categoryId])
}

model DocVersion {
  id          String   @id @default(cuid())
  pageId      String
  title       String
  content     String
  savedAt     DateTime @default(now())
  savedByName String?

  page DocPage @relation(fields: [pageId], references: [id], onDelete: Cascade) // Cascade: Verlauf gehört zur Seite (eine Seite wird samt Verlauf gelöscht)

  @@index([pageId, savedAt])
}

// Bilder in Dokumentationsseiten (Datei unter <Datenverzeichnis>/files/doku/<bereich>/)
model DocImage {
  id        String   @id @default(cuid())
  area      String
  name      String
  mime      String
  size      Int
  path      String   @unique
  createdAt DateTime @default(now())

  @@index([area])
}

// Ein-/Ausschalter für Module und Funktionen. Schlüssel: Modul-ID ("office") oder Funktions-ID ("office.fleet").
// Kein Eintrag = aktiv. Daten bleiben beim Ausschalten erhalten; es wird nur der Zugriff gesperrt.
model FeatureSetting {
  key           String   @id
  enabled       Boolean
  updatedAt     DateTime @updatedAt
  updatedByName String?
}

// Audit-Log: wer hat wann was getan. Bewusst ohne Relation zu User, damit der Verlauf auch nach dem Löschen eines Benutzers erhalten bleibt.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  // Anzeigename zum Zeitpunkt der Aktion (oder der eingegebene Benutzername bei fehlgeschlagener Anmeldung)
  actorName  String
  // Maschinenlesbare Aktion, z. B. "user.create" (Beschriftung über i18n: audit.actions.*)
  action     String
  // Betroffenes Objekt: lesbare Bezeichnung (z. B. Benutzername, Kennzeichen, Rechnungsnummer)
  target     String?
  entityId   String?

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
}

// Einstellungen, die zur Laufzeit in der Oberfläche geändert werden (Schlüssel/Wert). Geheimnisse liegen verschlüsselt darin
// (Schlüsseldatei im Datenverzeichnis, nicht Teil von Backups).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ───────────── Ereignisse (Outbox) ─────────────
// Ereignisse für Webhooks, E-Mail u. a. entstehen nur im Aktions-Rahmen (src/server/operations): sie werden in derselben Transaktion wie die
// Änderung geschrieben und sind damit erst nach dem Commit sichtbar. Der Job-Runner (src/server/jobs) stellt sie zu: mindestens einmal, je
// Abnehmer genau einmal erfolgreich (OutboxDelivery); nach zu vielen Fehlversuchen gilt das Ereignis als fehlgeschlagen (failedAt).
model OutboxEvent {
  id          String           @id @default(cuid())
  // z. B. "invoice.paid"
  type        String
  entityId    String?
  // JSON als Text (bewusst kein Json-Feld)
  payload     String           @default("{}")
  actorId     String?
  createdAt   DateTime         @default(now())
  // frühester Zeitpunkt der nächsten Zustellung (Wiederholung mit Wartezeit)
  availableAt DateTime         @default(now())
  attempts    Int              @default(0)
  lastError   String?
  processedAt DateTime?
  // endgültig aufgegeben (zu viele Fehlversuche); bleibt zur Ansicht und zum Aufräumen erhalten
  failedAt    DateTime?
  deliveries  OutboxDelivery[]

  @@index([processedAt, failedAt, availableAt])
  @@index([type])
}

// Ein erfolgreich zugestellter Abnehmer eines Ereignisses (Idempotenz bei Wiederholung: ein bereits bedienter Abnehmer wird übersprungen).
model OutboxDelivery {
  id          String      @id @default(cuid())
  eventId     String
  event       OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade) // Cascade: Betriebsprotokoll der Zustellung
  handler     String
  deliveredAt DateTime    @default(now())

  @@unique([eventId, handler])
}

// ───────────── Job-Runner (src/server/jobs) ─────────────
// Geplante Jobs der Plattform und der Funktionen. Der Zustand liegt in der Datenbank, damit er einen Neustart überlebt: nächster Lauf, Fehlerserie
// (Wiederholung mit Wartezeit), Sperre gegen Doppelläufe. Die Definitionen (Zeitplan, Code) stehen im Code, nicht hier.
model JobState {
  // Job-ID, z. B. "backup.auto"
  id          String    @id
  nextRunAt   DateTime?
  lastRunAt   DateTime?
  // ok | error | interrupted | skipped
  lastStatus  String?
  lastMessage String?
  // Fehlversuche in Folge (0 nach einem Erfolg)
  failures    Int       @default(0)
  // Sperre: bis dahin läuft der Job (oder lief, als der Prozess endete); wird beim Start freigegeben
  lockedUntil DateTime?
  lockOwner   String?
  updatedAt   DateTime  @updatedAt
}

// Ergebnis jedes Laufs (Aufbewahrung: Jobs „platform.jobs-prune“).
model JobRun {
  id         String    @id @default(cuid())
  jobId      String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  // running | ok | error | interrupted
  status     String
  attempt    Int       @default(1)
  durationMs Int?
  // Ergebnis in Worten bzw. Fehlerart (ohne Nutzdaten)
  message    String?

  @@index([jobId, startedAt])
  @@index([startedAt])
}

// ───────────── Programmierschnittstelle (API-Kern, /api/v1) ─────────────

// API-Token: gespeichert wird nur der SHA-256-Hash (das Token ist hochentropisch, ein langsamer Hash wäre sinnlos), das Klartext-Token
// steht ausschließlich in der Antwort der Erzeugung. Wirksame Rechte bei jeder Anfrage: Scope ∩ aktuelle Rechte des Besitzers (nie adminOnly).
// Bewusst ohne updatedAt: "zuletzt benutzt" wird gedrosselt geschrieben und soll keine Änderung der Zeile sein. Besitzer gelöscht = Token weg.
model ApiToken {
  id                 String    @id @default(cuid())
  name               String
  tokenHash          String    @unique
  // erste Zeichen des Tokens (nicht geheim, nur zum Wiedererkennen in Listen und im Audit-Log)
  hint               String
  userId             String
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  createdByName      String?
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  // Anfragen pro Minute für dieses Token
  rateLimitPerMinute Int       @default(120)
  // Beschreibung (wofür das Token gedacht ist; nur Anzeige)
  description        String?
  // Beschränkung auf Adressbereiche (CIDR, ein Eintrag je Zeile; null = keine). Wirkt nur mit der Einstellung „Hinter Reverse-Proxy“, sonst ist das Token unbrauchbar (fail-closed).
  allowedNets        String?

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade) // Cascade: gehört zum Konto (Zugangsdaten)
  scope ApiTokenScope[]

  @@index([userId])
  @@index([expiresAt])
}

// Rechte, die das Token höchstens tragen darf (Schlüssel wie in der Rechte-Maske, z. B. "customers.view")
model ApiTokenScope {
  tokenId    String
  permission String

  token ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade) // Cascade: Bestandteil des Tokens

  @@id([tokenId, permission])
}

// Webhook (F11): ein Ziel, an das die Anwendung Ereignisse meldet. Die Nutzlast trägt nur Ereignis-ID, Typ, Zeitpunkt und die ID der Sache – nie Fachdaten. Das Geheimnis der Signatur liegt
// verschlüsselt in den Einstellungen (`webhook.secret.<id>`, `setSecret`), nicht hier.
model Webhook {
  id                  String            @id @default(cuid())
  name                String
  url                 String
  // abonnierte Ereignistypen, durch Komma getrennt (Text, bewusst kein Json-Feld)
  events              String
  enabled             Boolean           @default(false)
  // ausdrückliche Freigabe der Administration für ein Ziel im eigenen Netz (private Adressen, auch http)
  allowPrivate        Boolean           @default(false)
  // bis dahin signiert die Anwendung zusätzlich mit dem vorherigen Geheimnis (Rotation mit Überlappung)
  previousSecretUntil DateTime?
  // warum die Anwendung das Ziel selbst ausgeschaltet hat: "gone" (410) | "secret" (Geheimnis unlesbar) | "restore" (nach einer Wiederherstellung: eine Kopie darf nie an Produktivempfänger senden)
  disabledReason      String?
  // Ereignisse, die verworfen wurden, weil die Warteschlange des Ziels voll war (zurückgestellt: 500, wartend: 5000); wird beim Einschalten nach dem Nachholen im Audit genannt und zurückgesetzt
  droppedEvents       Int               @default(0)
  createdByName       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deliveries          WebhookDelivery[]
}

// Zustellprotokoll UND Warteschlange: eine Zeile je Ereignis und Ziel. Ohne Nutzlast und ohne Antworttext – gespeichert sind nur Zustand, Statuscode, Fehlercode und Dauer.
model WebhookDelivery {
  id             String    @id @default(cuid())
  webhookId      String
  // Cascade mit Absicht: das Zustellprotokoll ist ein Betriebsprotokoll (30 Tage, keine Nutzlast), kein Nachweis über Fachdaten – das Audit-Log hält das Löschen des Ziels mit Host fest; die Oberfläche kündigt „entfernt auch das Protokoll“ an
  webhook        Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade) // Cascade: Betriebsprotokoll der Zustellung (nach Frist ohnehin gelöscht)
  // Ereignis-ID (Outbox-Ereignis; Test: "test_…") – der Empfänger erkennt Wiederholungen daran
  eventId        String
  type           String
  entityId       String?
  eventAt        DateTime
  // pending | held (Ziel ausgeschaltet, bis zu 14 Tage zurückgestellt) | sent | failed (aufgegeben) | gone (Empfänger meldete 410) | suppressed (Art. 18: nicht gesendet, keine Störung)
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastAttemptAt  DateTime?
  // HTTP-Statuscode der letzten Antwort
  lastStatus     Int?
  // Fehlercode des letzten Versuchs (kein Text des Empfängers)
  lastError      String?
  lastDurationMs Int?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@unique([webhookId, eventId])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

// Idempotenz-Schlüssel (Header Idempotency-Key): je Token, Methode+Pfad und Schlüssel höchstens eine Zeile. status = null: Anfrage läuft noch.
model ApiIdempotencyKey {
  id        String   @id @default(cuid())
  tokenId   String
  scope     String
  key       String
  bodyHash  String
  status    Int?
  response  String?
  headers   String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([tokenId, scope, key])
  @@index([expiresAt])
}

// E-Mail-Versand (Plattform server/mail): Warteschlange UND Sendeprotokoll in einer Tabelle. Das Protokoll zeigt Zeit, Absender, Empfänger, Betreff, Status und Fehlercode – nie den Inhalt:
// `body` und `attachments` stehen nur bis zum Versand (danach geleert) bzw. bei Aufgegebenem 30 Tage (zum erneuten Senden). Keine Verknüpfung zu User: das Protokoll überlebt das Löschen eines Kontos.
model MailMessage {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  // Absender-Benutzer (null = System) und sein Anzeigename zum Zeitpunkt des Versands
  userId      String?
  userName    String
  // Empfänger, durch Komma getrennt (Text, bewusst kein Json-Feld)
  toAddresses String
  subject     String
  // "queued" (wartet oder wartet auf Wiederholung) | "sent" | "failed" (aufgegeben)
  status      String    @default("queued")
  attempts    Int       @default(0)
  // Fehlercode des letzten Versuchs (z. B. "auth", "tls", "recipient"), nie ein Text des Servers
  errorCode   String?
  // Empfänger, die die Nachricht schon angenommen hat (Teilmenge von toAddresses, durch Komma getrennt); Wiederholung und „Erneut senden“ gehen nur an die übrigen. Nur Adressen, kein Inhalt
  deliveredTo String?
  sentAt      DateTime?
  // Fachlicher Bezug (z. B. "invoice") und ID – nur zur Zuordnung, ohne Inhalt
  purpose     String?
  entityId    String?
  // Inhalt bis zum Versand; Anhänge als Text "relativer Pfad|Dateiname|Typ" je Zeile (Dateien liegen unter /data/files, siehe files.ts)
  body        String?
  attachments String?

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ───────────── Zähler (Plattform, F2): fortlaufende, lückenlose Nummern ─────────────

// Ein Zähler je Schlüssel (und Jahr). Der nächste Wert wird in der Transaktion vergeben, die die Nummer verbraucht (`nextCounterValue`, src/server/counters.ts): scheitert sie, bleibt auch der
// Zähler stehen – es gibt keine Lücken. Schlüssel gehören den Funktionen ("orders", später "invoices" …); year = 0: Zähler ohne Jahreswechsel.
model Counter {
  key       String
  year      Int      @default(0)
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([key, year])
}

// ───────────── Werkstattaufträge / Arbeitskarten (F2, workshop.orders) ─────────────

model Order {
  id            String    @id @default(cuid())
  // fortlaufend und lückenlos, Muster A-JJJJ-NNNN (Zähler "orders")
  number        String    @unique
  // accepted | in_progress | ready | picked_up | cancelled
  status        String    @default("accepted")
  vehicleId     String
  // Kunde zum Zeitpunkt der Annahme (aus dem Fahrzeughalter abgeleitet, oder direkt gewählt); null = ohne Kunde
  customerId    String?
  appointmentId String?
  // Kundenwunsch / Beschreibung des Auftrags
  request       String?
  // Kilometerstand bei Annahme (schreibt – wenn höher – ins Fahrzeug)
  mileageKm     Int?
  acceptedAt    DateTime  @default(now())
  // Zeitpunkt des Abschlusses ("Abgeholt"); beim Wiedereröffnen wieder null
  closedAt      DateTime?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Aufträge werden nie gelöscht (Status "Storniert"); Fahrzeug und Kunde sind deshalb Restrict
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appointment Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  findings    OrderFinding[]
  approvals   OrderApproval[]
  events      OrderEvent[]
  // Zeiterfassung (F5): Zeiten auf diesen Auftrag (Aufträge werden nie gelöscht)
  timeEntries TimeEntry[]
  // Dokumente & Fotos (F6)
  files       FileAttachment[]
  // Checklisten (F7)
  checklists  Checklist[]
  // Belege der Rechnungserstellung (F3)
  invoices    Invoice[]

  @@index([status, acceptedAt])
  @@index([vehicleId])
  @@index([customerId])
  @@index([appointmentId])
  @@index([acceptedAt])
}

// Position eines Auftrags (Arbeit, Teil, Sonstiges). Preise netto in ganzen Cent, Menge in Tausendsteln, Sätze in Basispunkten (src/lib/line-items.ts).
model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  position      Int
  // labor | part | other
  kind          String  @default("labor")
  description   String
  unit          String  @default("")
  quantityMilli Int
  unitCents     Int
  taxBp         Int
  discountBp    Int     @default(0)
  // Verweis, den eine andere Funktion setzt (z. B. refType "article", refId = Artikel); der Auftrag kennt die Bedeutung nicht
  refType       String?
  refId         String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade) // Cascade: Bestandteil des Auftrags (Aufträge sind nicht löschbar)

  @@index([orderId, position])
  @@index([refType, refId])
}

// Befund (Freitext, mehrere je Auftrag)
model OrderFinding {
  id         String   @id @default(cuid())
  orderId    String
  text       String
  authorName String
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade) // Cascade: Bestandteil des Auftrags (Aufträge sind nicht löschbar)

  @@index([orderId, createdAt])
}

// Freigabe-Protokoll bei Mehrarbeit: unveränderlich (kein Bearbeiten, kein Löschen), nur anlegen
model OrderApproval {
  id             String   @id @default(cuid())
  orderId        String
  // freigegebener Mehrbetrag, brutto in Cent
  amountCents    Int
  reason         String
  // signature (Unterschrift am Tablet, PNG unter /data/files) | typed (getippter Name mit Bestätigung) | phone (telefonisch)
  method         String
  approverName   String
  // relativer Pfad der Unterschrift (nur method = signature)
  signaturePath  String?
  // SHA-256 des Unterschrift-Bildes (nur method = signature): dasselbe Bild gilt nie für eine zweite Freigabe (kein Wiederverwenden einer Zeichnung)
  signatureHash  String?
  // der getippte und bestätigte Name (nur method = typed); stimmt normalisiert mit approverName überein
  signedName     String?
  recordedByName String
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade) // Cascade: Bestandteil des Auftrags (Aufträge sind nicht löschbar)

  @@index([orderId, createdAt])
  @@index([signatureHash])
}

// Verlauf: Annahme, Statuswechsel, Wiedereröffnen, Freigaben (Timeline)
model OrderEvent {
  id      String   @id @default(cuid())
  orderId String
  // created | status | reopened | approval
  kind    String
  status  String?
  byName  String
  note    String?
  at      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade) // Cascade: Bestandteil des Auftrags (Aufträge sind nicht löschbar)

  @@index([orderId, at])
}

// ───────────── Teile & Lager (F4, workshop.parts) ─────────────

model Article {
  id            String    @id @default(cuid())
  // Artikelnummer, eindeutig
  number        String    @unique
  name          String
  // normalisierte Suchspalte (Artikelnummer und Bezeichnung, src/lib/search-key.ts)
  searchKey     String    @default("")
  unit          String    @default("Stk")
  supplier      String?
  // Einkaufs- und Verkaufspreis netto in ganzen Cent (nur mit Recht parts.prices gelesen)
  purchaseCents Int?
  saleCents     Int?
  // Steuersatz in Basispunkten
  taxBp         Int       @default(1900)
  // Bestand und Mindestmenge in Tausendsteln der Einheit; negativer Bestand ist erlaubt (mit Warnung)
  stockMilli    Int       @default(0)
  minStockMilli Int       @default(0)
  notes         String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  movements StockMovement[]

  @@index([archivedAt])
  @@index([name])
}

// Lagerbewegung: unveränderlich (nur anlegen). Vorzeichen in quantityMilli: Zugang +, Abgang −.
model StockMovement {
  id              String   @id @default(cuid())
  articleId       String
  // receipt (Wareneingang) | order (Auftragsabgang) | correction (Inventur/Korrektur) | reversal (Rückbuchung beim Wiedereröffnen)
  kind            String
  quantityMilli   Int
  stockAfterMilli Int
  // Bezug zum Auftrag (ohne Fremdschlüssel: die Funktion kennt Aufträge nur über ihre Hooks)
  orderId         String?
  orderNumber     String?
  // Lieferschein / Eingangsrechnung (Nummer, von Hand eingetragen) bzw. Bezeichnung der Inventur
  reference       String?
  note            String?
  byName          String
  createdAt       DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@index([orderId])
}

// ───────────── Zeiterfassung (F5, office.time) ─────────────

// Einstellungen der Zeiterfassung (Singleton): Sollzeit je Arbeitstag der Person (Arbeitstage: Employee.workWeekdays)
model TimeSettings {
  id                 String   @id @default("default")
  dailyTargetMinutes Int      @default(480)
  updatedAt          DateTime @updatedAt
}

// Zeiteintrag eines Mitarbeiters, optional auf einen Auftrag. Zeiten werden nie überschrieben und nie gelöscht: Korrekturen stehen mit Begründung in TimeCorrection, Stornierte tragen voidedAt.
model TimeEntry {
  id                String    @id @default(cuid())
  employeeId        String
  orderId           String?
  startedAt         DateTime
  // null = läuft
  endedAt           DateTime?
  // manuell erfasste Pause in Minuten (wird von der Dauer abgezogen)
  breakMinutes      Int       @default(0)
  activity          String?
  note              String?
  // stamp (gestempelt) | manual (nachgetragen, mit Begründung)
  source            String    @default("stamp")
  // Eindeutig, solange der Eintrag läuft (= employeeId), danach null: so läuft je Mitarbeiter höchstens ein Eintrag, auch bei gleichzeitigem Start
  runningKey        String?   @unique
  // Idempotenzschlüssel von Start und Ende (Doppeltippen, Wiederholung nach verlorener Antwort)
  startKey          String?   @unique
  stopKey           String?   @unique
  voidedAt          DateTime?
  // Als Position in den Auftrag übernommen (einmalig)
  transferredAt     DateTime?
  transferredItemId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  corrections TimeCorrection[]

  @@index([employeeId, startedAt])
  @@index([orderId])
  @@index([startedAt])
}

// Korrekturverlauf: der Stand VOR der Änderung samt Begründung (Original bleibt nachvollziehbar)
model TimeCorrection {
  id               String    @id @default(cuid())
  entryId          String
  // edit (geändert) | void (storniert) | create (nachgetragen)
  kind             String
  reason           String
  byName           String
  at               DateTime  @default(now())
  prevStartedAt    DateTime?
  prevEndedAt      DateTime?
  prevBreakMinutes Int?
  prevOrderId      String?
  prevActivity     String?
  prevNote         String?

  entry TimeEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@index([entryId, at])
}

// ───────────── Dokumente & Fotos (F6, workshop.files) ─────────────

// Datei an einem Fahrzeug ODER einem Auftrag (genau eines von vehicleId/orderId, von der Operation erzwungen). Die Datei selbst liegt unter /data/files (relativer Pfad, nie überschrieben, nie verändert –
// Backups nutzen Hardlinks); die Zeile hält Metadaten. Entfernt wird per archivedAt, nie durch Löschen; Fahrzeug und Auftrag sind Restrict (kein stilles Cascade auf Historie).
model FileAttachment {
  id             String    @id @default(cuid())
  vehicleId      String?
  orderId        String?
  // photo | document | damage | intake | work | other (Konstanten im Code)
  category       String    @default("photo")
  caption        String?
  // Anzeigename (aus dem hochgeladenen Namen, gekürzt) und ERKANNTER Typ (Magic Bytes), Größe nach der Bereinigung
  name           String
  mime           String
  size           Int
  width          Int?
  height         Int?
  // relativer Pfad unter /data/files
  path           String
  // SHA-256 des hochgeladenen Originals (Idempotenz: derselbe Schlüssel mit anderem Inhalt wird abgelehnt)
  sha256         String
  // Idempotenzschlüssel des Uploads (Header Idempotency-Key): dieselbe Datei zweimal ergibt keine Dublette
  uploadKey      String?
  // hochladende Person (ohne Fremdschlüssel: Konten werden gelöscht, die Datei bleibt) und Name zum Zeitpunkt
  uploadedById   String
  uploadedByName String
  // Metadaten (Exif/GPS, Kommentare, Anhängsel) wurden entfernt; Anzahl entfernter Bytes
  strippedBytes  Int       @default(0)
  archivedAt     DateTime?
  archivedByName String?
  // Datei endgültig vom Datenträger gelöscht (Löschlauf, einige Tage nach dem Entfernen; Backups behalten ihre Verweise); die Zeile bleibt als Nachweis ohne Name und Beschriftung
  purgedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([uploadedById, uploadKey])
  @@index([archivedAt, purgedAt])
  @@index([vehicleId, archivedAt, createdAt])
  @@index([orderId, archivedAt, createdAt])
  @@index([createdAt])
}

// ───────────── Checklisten (F7, workshop.checklists) ─────────────

// Vorlage einer Checkliste (Annahmeprotokoll, Ölwechsel, Reifenwechsel, HU-Vorbereitung oder eigene). Jede Änderung erzeugt eine NEUE Version (ChecklistTemplateVersion); begonnene und abgeschlossene Checklisten
// tragen ihre Punkte als Kopie und ändern sich nie mit der Vorlage. standardKey kennzeichnet die mitgelieferten Vorlagen (intake | oil | tires | hu).
model ChecklistTemplate {
  id          String    @id @default(cuid())
  standardKey String?   @unique
  // zuletzt gültiger Name (der Name jeder Version steht an der Version)
  name        String
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions   ChecklistTemplateVersion[]
  checklists Checklist[]
}

model ChecklistTemplateVersion {
  id            String   @id @default(cuid())
  templateId    String
  version       Int
  name          String
  description   String?
  // none | optional | required (Kundenunterschrift beim Abschluss)
  signatureMode String   @default("none")
  // Anmerkung zur Änderung
  note          String?
  createdByName String
  createdAt     DateTime @default(now())

  template   ChecklistTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  items      ChecklistTemplateItem[]
  checklists Checklist[]

  @@unique([templateId, version])
}

// Punkt einer Vorlagenversion. type: check (Haken) | measure (Messwert mit Einheit und Grenzen) | torque (Drehmoment in Nm mit Sollwert) | choice (Auswahl) | text (Freitext) | photo (Foto-Hinweis, wird abgehakt)
model ChecklistTemplateItem {
  id        String  @id @default(cuid())
  versionId String
  position  Int
  label     String
  type      String
  unit      String?
  minValue  Float?
  maxValue  Float?
  targetValue Float?
  // Auswahlmöglichkeiten, eine je Zeile
  options   String?
  required  Boolean @default(true)
  hint      String?

  version ChecklistTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade) // Cascade: Bestandteil der Vorlagenversion

  @@index([versionId, position])
}

// Eine Checkliste an einem Fahrzeug (und optional einem Auftrag). Status: open | completed | discarded. Abgeschlossen = unveränderlich; Wiederöffnen nur mit Recht und Begründung (Verlauf).
model Checklist {
  id              String    @id @default(cuid())
  templateId      String
  versionId       String
  // Kopie von Name, Version und Art (Annahmeprotokoll) zum Zeitpunkt des Beginns
  templateName    String
  templateVersion Int
  standardKey     String?
  signatureMode   String    @default("none")
  vehicleId       String
  orderId         String?
  status          String    @default("open")
  // Kundenname (Unterschrift) und die Unterschrift: PNG unter /data/files oder getippter Name; Prüfsumme gegen Wiederverwendung des Bildes
  customerName    String?
  signaturePath   String?
  signatureHash   String?
  signedName      String?
  note            String?
  completedAt     DateTime?
  completedByName String?
  createdByName   String
  // Konto, das die Checkliste begonnen hat (ohne Fremdschlüssel: Konten werden gelöscht, die Checkliste bleibt); das Recht zum Verwerfen hängt daran, nie am Anzeigenamen
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  template ChecklistTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version  ChecklistTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  vehicle  Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  order    Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items    ChecklistItem[]
  events   ChecklistEvent[]

  @@index([vehicleId, createdAt])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([signatureHash])
  @@index([templateId])
  @@index([versionId])
}

// Punkt einer Checkliste: Kopie des Vorlagenpunkts plus Ergebnis. updatedAt ist die Version des einzelnen Punkts (gleichzeitiges Abhaken).
model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  position    Int
  label       String
  type        String
  unit        String?
  minValue    Float?
  maxValue    Float?
  targetValue Float?
  options     String?
  required    Boolean   @default(true)
  hint        String?
  done        Boolean   @default(false)
  numberValue Float?
  textValue   String?
  doneByName  String?
  doneAt      DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade) // Cascade: Bestandteil der Checkliste (Checklisten sind nicht löschbar)

  @@index([checklistId, position])
}

// Verlauf einer Checkliste: begonnen, abgeschlossen, wieder geöffnet (mit Begründung und der bisherigen Unterschrift, die auf dem Datenträger bleibt), verworfen
model ChecklistEvent {
  id            String   @id @default(cuid())
  checklistId   String
  // created | completed | reopened | discarded
  kind          String
  byName        String
  note          String?
  signaturePath String?
  // Prüfsumme der Unterschrift, die beim Wiederöffnen aufgehoben wurde: das Bild bleibt für andere Checklisten gesperrt
  signatureHash String?
  at            DateTime @default(now())

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade) // Cascade: Bestandteil der Checkliste (Checklisten sind nicht löschbar)

  @@index([checklistId, at])
  @@index([signatureHash])
}

