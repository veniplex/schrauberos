# Vorlage für die Docker-Konfiguration. Kopieren nach `.env` (neben docker-compose.yml) und anpassen.

# PFLICHT: langes, zufälliges Datenbank-Passwort
POSTGRES_PASSWORD=bitte-aendern

# Port auf dem Server und Zeitzone
APP_PORT=3000
TZ=Europe/Berlin

# true, wenn die App über HTTPS erreichbar ist (Reverse Proxy/Tunnel); false bei reinem HTTP im LAN.
# Bei falschem Wert ist kein Login möglich.
SESSION_COOKIE_SECURE=false

# Erst-Admin (wird nur angelegt, solange noch kein Benutzer existiert; Passwortwechsel beim ersten Login)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin
# Demo-Daten (Kunden, Autos, Reifen, Termine) – nur zum Ausprobieren
SEED_DEMO=false

# Welche Image-Version laufen soll: latest oder z. B. 1.0.0 (siehe GitHub → Packages)
SCHRAUBEROS_VERSION=latest
