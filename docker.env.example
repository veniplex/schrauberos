# Vorlage für die Docker-Konfiguration. Kopieren nach `.env` (neben docker-compose.yml) und anpassen.
POSTGRES_PASSWORD=bitte-aendern
APP_PORT=3000
TZ=Europe/Berlin

# true, wenn die App hinter HTTPS (Reverse Proxy) erreichbar ist; false bei reinem HTTP im LAN
SESSION_COOKIE_SECURE=false

# Erst-Admin (wird nur angelegt, solange noch kein Benutzer existiert; Passwortwechsel beim ersten Login)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin
# Demo-Daten (Kunden, Autos, Reifen, Termine) – nur zum Ausprobieren
SEED_DEMO=false
