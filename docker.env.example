# Optional: Kopieren nach `.env` (neben docker-compose.yml). Ohne diese Datei laufen die Standardwerte.
# Alles Weitere (Zeitzone, Backups, Update-Zugang, Administrator) wird in der Weboberfläche eingestellt.

# Port auf dem Server
APP_PORT=3000

# Welche Image-Version beim Neu-Erstellen des Containers verwendet wird: latest oder z. B. 1.0.0.
# Updates im laufenden Betrieb erfolgen über die Weboberfläche (Verwaltung → Updates).
SCHRAUBEROS_VERSION=latest
