# Lokale Entwicklung: SQLite-Datei (relativ zum Projektordner)
DATABASE_URL="file:./dev.db"
# Produktion (Docker): PostgreSQL
# DATABASE_URL="postgresql://schrauberos:schrauberos@localhost:5432/schrauberos"

# Zeitzone der Werkstatt (Termine werden in dieser Zeitzone angezeigt/eingegeben)
TZ="Europe/Berlin"

# Erst-Admin beim Seeden (Passwort muss beim ersten Login geändert werden)
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="admin"
# Demo-Daten (Kunden, Autos, Reifen, Termine) mit anlegen: true/false
SEED_DEMO="true"
