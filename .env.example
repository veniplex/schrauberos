# Lokale Entwicklung: SQLite-Datei (relativ zum Projektordner). Im Docker-Container steht sie unter /data.
DATABASE_URL="file:./dev.db"

# Nur für `npm run db:fresh` / `prisma db seed` (lokale Entwicklung): Entwicklungs-Admin und Beispieldaten.
# In Produktion richtet man den Administrator beim ersten Aufruf im Browser ein.
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="admin"
SEED_DEMO="true"
